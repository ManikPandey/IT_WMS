generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id               Int      @id @default(autoincrement())
  asset_tag        String   @unique
  serial_number    String?  @unique
  type             String
  status           String
  jsonb_attributes Json?
  assigned_to      Int?
  warehouse_id     Int
  category_id      Int?
  po_id            Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([serial_number])
}

model Category {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  parent_id        Int?
  attribute_schema Json?
}

model MaintenanceTicket {
  id          Int       @id @default(autoincrement())
  asset_id    Int
  issue_type  String
  description String
  status      String    @default("OPEN") // OPEN, RUNNING, PENDING_APPROVAL, CLOSED
  parts_used  String[]
  bill_url    String?
  cost        Float?
  admin_note  String?
  created_at  DateTime  @default(now())
  resolved_at DateTime?
}

model OutboxEvent {
  id           Int      @id @default(autoincrement())
  event_type   String
  payload_json Json
  published    Boolean  @default(false)
  created_at   DateTime @default(now())
}
