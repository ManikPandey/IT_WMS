generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  name          String
  email         String   @unique
  password_hash String
  role          String
}

model PurchaseOrder {
  id                Int       @id @default(autoincrement())
  vendor            String
  status            String
  idempotency_key   String    @unique
  request_date      DateTime  @default(now())
  action_date       DateTime?
  gstin             String?
  department        String?
  billing_address   String?
  delivery_address  String?
  receiving_office  String?
  custom_attributes Json?
  document_url      String?
  created_at        DateTime  @default(now())
  line_items        POLineItem[]
}

model POLineItem {
  id            Int           @id @default(autoincrement())
  po_id         Int
  category_id   Int
  description   String
  quantity      Int
  unit_price    Float
  received_qty  Int           @default(0)
  purchase_order PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
}

model AssetRequest {
  id             Int       @id @default(autoincrement())
  requested_by   Int       // User ID
  category_id    Int       // Category ID in inventory-service
  justification  String
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approved_by    Int?      // User ID of Admin
  resolved_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

model AuditLog {
  id                 Int      @id @default(autoincrement())
  event_type         String
  entity_id          Int
  payload_json       Json
  processed_event_id String   @unique
  created_at         DateTime @default(now())
}

model OutboxEvent {
  id           Int      @id @default(autoincrement())
  event_type   String
  payload_json Json
  published    Boolean  @default(false)
  created_at   DateTime @default(now())
}

model DashboardSummary {
  id                     Int      @id @default(1)
  total_assets           Int      @default(0)
  total_maintenance_cost Float    @default(0.0)
  active_issues          Int      @default(0)
  in_stock_assets        Int      @default(0)
  out_of_stock_assets    Int      @default(0)
  updated_at             DateTime @updatedAt
}
